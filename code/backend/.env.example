# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_DATABASE=vessel_system
DB_CHARSET=utf8mb4

# 服务器配置
PORT=3001
NODE_ENV=development

# API配置
API_PREFIX=/api/v1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 安全配置
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:3000