{
  "name": "近海船只航行和港口管理系统",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "tailwind": "tailwindcss -i ./src/style.css -o ./src/assets/main.css",
    "tailwind:watch": "tailwindcss -i ./src/style.css -o ./src/assets/main.css --watch"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "pinia": "^3.0.4",
    "postcss": "^8.5.6",
    "recharts": "^3.5.1",
    "tailwindcss": "^4.1.17",
    "tailwindcss-themes": "^1.0.0",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vitest/ui": "^1.6.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.2.5",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^1.6.0",
    "vue-tsc": "^3.1.5"
  }
}
